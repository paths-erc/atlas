# Production build configuration (loaded by `npm run build` / CRA).
#
# The atlas talks to the live BraDypUS v5 instance that hosts the PAThs app.
# API calls go to  <base>/<app>/api/...      (app-scoped since bdus v5.9.0;
#                                             see src/components/Services/Database/Database.jsx)
# File/image URLs go to  <base>/projects/paths/files/...
#
# REACT_APP_API_KEY is NOT set here on purpose: it is injected from a GitHub
# Actions repo secret in .github/workflows/deploy.yml. For a manual production
# build, export it in the shell or add it to a git-ignored .env.production.local.
REACT_APP_API_BASE=https://bdus.lad-sapienza.it
REACT_APP_APP=paths
